{
  "name": "healthcare",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nx run-many -t serve dev -p api notification-worker integration-worker staff portal --parallel=8 --output-style=stream",
    "dev:staff": "nx run staff:dev",
    "dev:portal": "nx run portal:dev",
    "dev:api": "nx serve api",
    "dev:worker": "nx serve notification-worker",
    "dev:integration-worker": "nx serve integration-worker",
    "dev:deps": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "db:migrate": "node -r @swc-node/register tools/db/migrate.ts",
    "db:seed": "node -r @swc-node/register tools/db/seed.ts",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "test:integration": "nx run-many -t integration",
    "test:e2e": "nx run e2e:e2e",
    "storybook": "nx run @healthcare/ui:storybook",
    "build-storybook": "nx run @healthcare/ui:build-storybook",
    "graph": "nx graph",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:instrument-gateway": "nx serve instrument-gateway"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "11.2.6",
    "@node-rs/argon2": "^2.2.1",
    "bullmq": "^5.81.5",
    "drizzle-orm": "^0.45.3",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.12",
    "otplib": "^12.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/jest": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/nest": "23.2.1",
    "@nx/node": "23.2.1",
    "@nx/web": "23.2.1",
    "@nx/webpack": "23.2.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@types/express": "^5.0.6",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "dotenv": "^18.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "nx": "23.2.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  }
}
