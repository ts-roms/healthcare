# Copy to .env for local development. Never commit real secrets.
# NODE_ENV is not set here: Nx loads this file into every task, and Next.js builds
# require NODE_ENV=production. The API defaults to development.
PORT=3333
LOG_LEVEL=debug

DATABASE_URL=postgres://healthcare:healthcare@localhost:5432/healthcare
# Used by integration tests; the database is migrated and truncated by the tests.
TEST_DATABASE_URL=postgres://healthcare:healthcare@localhost:5432/healthcare_test
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# 32 random bytes, base64. Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
# Encrypts prepared integration payloads (PhilHealth claims, DOH case reports) for the integration worker.
# Required in production, separate from MFA_ENCRYPTION_KEY; the API and the worker need the same keys. Either one key
# (key id "default"), or a key ring to rotate without draining the queue (docs/runbooks/integration-payload-key-rotation.md):
# INTEGRATION_PAYLOAD_KEY=<32 random bytes, base64>
# INTEGRATION_PAYLOAD_KEYS={"2026-10":"<32 random bytes, base64>"}
# INTEGRATION_PAYLOAD_KEY_ID=2026-10
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# The staff app calls the API server-to-server and forwards each browser's IP (X-Forwarded-For) for
# per-client rate limits and the audit trail. Trust it only when the API is not reachable directly.
TRUST_PROXY=true

S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=healthcare-documents
S3_ACCESS_KEY_ID=healthcare
S3_SECRET_ACCESS_KEY=healthcare-dev-secret
S3_FORCE_PATH_STYLE=true

SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Healthcare Platform <no-reply@localhost>"

# Telemedicine video (LiveKit). Leave unset to run online consultations without video (the clinician calls the
# patient's callback number). With `pnpm dev:deps` the dev server below is available:
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# Online payment through PayMongo (optional; docs/domains/billing.md). Use test keys until a test-mode payment has
# gone through end to end. The webhook must be registered for checkout_session.payment.paid.
# PAYMONGO_SECRET_KEY=sk_test_xxx
# PAYMONGO_WEBHOOK_SECRET=whsk_xxx
# PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya

# Used only by `pnpm db:seed` to create the first platform administrator.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Staff app and patient portal: where their servers reach the API. Tokens never reach the browser.
API_BASE_URL=http://localhost:3333/api/v1
# Staff app: the realtime socket as the *browser* reaches it (default: the API origin + /realtime).
# REALTIME_URL=http://localhost:3333/realtime
# Patient portal (apps/portal): the organization it serves (organization.code; the seed creates "demo").
PORTAL_ORGANIZATION_CODE=demo
# Web Push to patients' browsers (optional; generate the pair with `npx web-push generate-vapid-keys`). All three or none.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:privacy@example.ph
# Public address of the patient portal, used in password-reset emails (none is sent without it).
PORTAL_BASE_URL=http://localhost:3001

# FHIR R4 read interface (docs/interoperability/fhir.md). All optional.
# FHIR_BASE_URL=https://api.example.ph/api/v1/fhir/r4
# FHIR_IDENTIFIER_BASE=https://ids.example.ph
# FHIR_IDENTIFIER_SYSTEMS={"philhealth_pin":"<official URI once confirmed>"}
