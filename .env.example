# Copy to .env for local development. Never commit real secrets.
# NODE_ENV is not set here: Nx loads this file into every task, and Next.js builds
# require NODE_ENV=production. The API defaults to development.
PORT=3333
LOG_LEVEL=debug

DATABASE_URL=postgres://healthcare:healthcare@localhost:5432/healthcare
# Used by integration tests; the database is migrated and truncated by the tests.
TEST_DATABASE_URL=postgres://healthcare:healthcare@localhost:5432/healthcare_test
REDIS_URL=redis://localhost:6379

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=14
# 32 random bytes, base64. Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# The staff app calls the API server-to-server and forwards each browser's IP (X-Forwarded-For) for
# per-client rate limits and the audit trail. Trust it only when the API is not reachable directly.
TRUST_PROXY=true

S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-southeast-1
S3_BUCKET=healthcare-documents
S3_ACCESS_KEY_ID=healthcare
S3_SECRET_ACCESS_KEY=healthcare-dev-secret
S3_FORCE_PATH_STYLE=true

SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Healthcare Platform <no-reply@localhost>"

# Telemedicine video (LiveKit). Leave unset to run online consultations without video (the clinician calls the
# patient's callback number). With `pnpm dev:deps` the dev server below is available:
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret

# Used only by `pnpm db:seed` to create the first platform administrator.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Staff app and patient portal: where their servers reach the API. Tokens never reach the browser.
API_BASE_URL=http://localhost:3333/api/v1
# Staff app: the realtime socket as the *browser* reaches it (default: the API origin + /realtime).
# REALTIME_URL=http://localhost:3333/realtime
# Patient portal (apps/portal): the organization it serves (organization.code; the seed creates "demo").
PORTAL_ORGANIZATION_CODE=demo
