{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "app.config.ts", "expo-env.d.ts", ".expo/types/**/*.ts"],
  "exclude": ["node_modules", "dist", ".expo"]
}
