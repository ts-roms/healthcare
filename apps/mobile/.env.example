# Built into the app (EXPO_PUBLIC_* values are readable in the binary — never put a secret here).
# The API the app talks to; from a phone or emulator, not "localhost" but the development machine's address.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3333/api/v1
# The organization this build serves (organization.code), like the web portal's PORTAL_ORGANIZATION_CODE.
EXPO_PUBLIC_ORGANIZATION_CODE=demo
