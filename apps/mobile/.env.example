# Built into the app (EXPO_PUBLIC_* values are readable in the binary — never put a secret here).
# The API the app talks to; from a phone or emulator, not "localhost" but the development machine's address.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3333/api/v1
# The organization this build serves (organization.code), like the web portal's PORTAL_ORGANIZATION_CODE.
EXPO_PUBLIC_ORGANIZATION_CODE=demo

# Store builds (docs/deployment/mobile-release.md). One app per organization; in EAS Build these come from the organization's
# EAS project instead of this file. Not secrets. Leave the identifiers empty until the organization has chosen them: builds
# refuse to run without them (they cannot be changed after the first store release).
MYHEALTH_APP_NAME=MyHealth
MYHEALTH_IOS_BUNDLE_ID=
MYHEALTH_ANDROID_PACKAGE=
# The organization's Expo account and project (written by `eas init`).
MYHEALTH_EXPO_OWNER=
EAS_PROJECT_ID=
