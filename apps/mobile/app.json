{
  "expo": {
    "name": "MyHealth",
    "slug": "healthcare-myhealth",
    "version": "0.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ]
    ],
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "experiments": {
      "typedRoutes": false
    }
  }
}
