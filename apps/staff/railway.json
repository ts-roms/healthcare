{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "NX_DAEMON=false pnpm nx run staff:build --output-style=static",
    "watchPatterns": [
      "apps/staff/**",
      "libs/ui/**",
      "libs/domain/**",
      "libs/web-session/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "nx.json",
      "tsconfig.base.json",
      "tsconfig.node.json",
      ".nvmrc"
    ]
  },
  "deploy": {
    "startCommand": "pnpm --dir apps/staff exec next start --port $PORT",
    "healthcheckPath": "/login",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
