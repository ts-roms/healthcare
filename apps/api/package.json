{
  "name": "@healthcare/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "api",
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/api/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/api/dist/patches",
          "{workspaceRoot}/apps/api/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "api:build:development"
          },
          "production": {
            "buildTarget": "api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "integration": {
        "executor": "nx:run-commands",
        "options": {
          "command": "jest --config apps/api/jest.integration.config.cts --runInBand",
          "cwd": "{workspaceRoot}"
        },
        "cache": false
      }
    },
    "tags": [
      "scope:api",
      "type:app"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "@healthcare/core": "workspace:*",
    "@healthcare/audit": "workspace:*",
    "@healthcare/auth": "workspace:*",
    "@healthcare/organization": "workspace:*",
    "@healthcare/patient": "workspace:*",
    "@healthcare/documents": "workspace:*",
    "@healthcare/notification": "workspace:*",
    "@healthcare/clinic": "workspace:*",
    "@healthcare/prescription": "workspace:*",
    "@healthcare/care-plan": "workspace:*",
    "@healthcare/laboratory": "workspace:*",
    "@healthcare/telemedicine": "workspace:*",
    "@healthcare/billing": "workspace:*",
    "@healthcare/pdf": "workspace:*",
    "@healthcare/interoperability": "workspace:*",
    "@healthcare/dental": "workspace:*",
    "@healthcare/inventory": "workspace:*",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@asymmetrik/fhir-json-schema-validator": "^0.9.8",
    "@nestjs/testing": "^11.0.0"
  }
}
