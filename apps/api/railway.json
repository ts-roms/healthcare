{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "NX_DAEMON=false pnpm nx run-many -t typecheck -p api --output-style=static && NX_DAEMON=false pnpm nx run api:build --output-style=static",
    "watchPatterns": [
      "apps/api/**",
      "libs/**",
      "database/**",
      "tools/db/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "nx.json",
      "tsconfig.base.json",
      "tsconfig.node.json",
      ".nvmrc"
    ]
  },
  "deploy": {
    "preDeployCommand": ["pnpm db:migrate"],
    "startCommand": "node apps/api/dist/main.js",
    "healthcheckPath": "/api/v1/health/ready",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
